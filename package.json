{
  "name": "taskmap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "npm run dev:server & npm run dev",
    "build": "tsc -b && vite build",
    "build:server": "npm run build --prefix server",
    "build:deploy": "npm run build && npm run build:server && npm run db:generate --prefix server",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:push": "npm run db:push --prefix server"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^6.4.3"
  }
}
