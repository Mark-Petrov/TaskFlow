# ── Application ──────────────────────────────────────────────────────────────
# Порт, на котором приложение доступно на хосте (контейнер всегда слушает 3000)
PORT=3000

# Публичный URL фронтенда (для CORS и WebSocket). Укажите домен VPS:
# CORS_ORIGIN=https://taskflow.example.com
CORS_ORIGIN=http://localhost:3000

# Секрет для JWT — обязательно замените на длинную случайную строку!
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (по умолчанию в Docker Compose, данные в volume taskflow-data):
DATABASE_URL=file:/data/taskflow.db

# PostgreSQL (опционально — раскомментируйте postgres в docker-compose и используйте):
# DATABASE_URL=postgresql://taskflow:your_password@postgres:5432/taskflow
# POSTGRES_USER=taskflow
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=taskflow

# ── Frontend build (только для сборки Docker-образа) ─────────────────────────
# Относительный путь — API и WebSocket на том же домене, что и фронтенд
VITE_API_URL=/api

# Если фронтенд и API на разных доменах (не нужно при деплое через один контейнер):
# VITE_WS_URL=https://taskflow.example.com
